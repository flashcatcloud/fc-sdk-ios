abstract_target 'Common' do
  pod 'OpenTelemetrySwiftApi', '1.13.1'
  pod 'FlashcatInternal', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  pod 'FlashcatCore', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  pod 'FlashcatLogs', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  pod 'FlashcatTrace', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  pod 'FlashcatRUM', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  pod 'FlashcatSessionReplay', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  pod 'FlashcatCrashReporting', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  pod 'FlashcatFlags', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE

  target 'App Dynamic iOS' do
    platform :ios, '13.0'
    use_frameworks!
    pod 'FlashcatWebViewTracking', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE
  end

  target 'App Static iOS' do
    platform :ios, '13.0'
    pod 'FlashcatWebViewTracking', :git => 'https://github.com/flashcatcloud/fc-sdk-ios.git', :GIT_REFERENCE

    target 'App Static iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Dynamic tvOS' do
    platform :tvos, '13.0'
    use_frameworks!
  end

  target 'App Static tvOS' do
    platform :tvos, '13.0'

    target 'App Static tvOS Tests' do
      inherit! :search_paths
    end
  end

end
